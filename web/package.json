{
  "name": "spotteur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "if [ -z \"$CI\" ] && [ \"$HUSKY\" != \"0\" ]; then cd .. && husky; fi",
    "dev": "next dev",
    "email:dev": "email dev --port=3001 --dir=./emails",
    "novu:dev": "novu dev --port 3000 --studio-host 0.0.0.0 --studio-port 3002 --headless",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "worker:dev": "tsx watch ./temporal/worker.ts",
    "worker:start": "tsx ./temporal/worker.ts",
    "lint": "prettier . --check && eslint .",
    "lint:fix": "prettier . --check --write && eslint --fix",
    "db:migrate": "npx -y drizzle-kit migrate",
    "db:generate": "npx -y drizzle-kit generate",
    "auth:generate-schema": "npx -y @better-auth/cli generate --output=./db/schema/auth.ts"
  },
